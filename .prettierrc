{
    "semi": true,
    "trailingComma": "es5",
    "singleQuote": true,
    "printWidth": 100,
    "tabWidth": 4,
    "useTabs": false,
    "bracketSpacing": true,
    "arrowParens": "always",
    "endOfLine": "auto",
    "singleAttributePerLine": false,
    "jsxBracketSameLine": false,
    "parser": "typescript",
    "bracketSameLine": false
}

